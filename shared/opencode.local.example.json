{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{file:~/.deepseek.url}",
        "apiKey": "{file:~/.deepseek.key}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek-V4.1-Flash-1017",
          "limit": {
            "context": 128000,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true
            }
          }
        }
      }
    }
  }
}
